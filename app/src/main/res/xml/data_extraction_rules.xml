<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore (holds the API key) lives under files/datastore, i.e. the *file* domain —
             not sharedpref. -->
        <exclude domain="file" path="datastore/hermes_settings.preferences_pb" />
        <exclude domain="database" path="hermes.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/hermes_settings.preferences_pb" />
        <exclude domain="database" path="hermes.db" />
    </device-transfer>
</data-extraction-rules>
