<?xml version="1.0" encoding="utf-8"?>
<!-- The Base URL is user-configured and may point at a plain-http intranet
     deployment; cleartext is therefore permitted globally, mirroring the
     native app's configuration. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
